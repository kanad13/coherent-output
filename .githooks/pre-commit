#!/usr/bin/env bash
# Fast gate for every commit, including those made from a shell where agent hooks do not fire.
# The full suite stays in scripts/verify.sh; bypass in an emergency with `git commit --no-verify`.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"
export PATH="${PATH:-}:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin"

[ -x node_modules/.bin/prettier ] || { echo "pre-commit: run 'npm ci' first." >&2; exit 1; }
node_modules/.bin/prettier --check . >/dev/null || { echo "pre-commit: formatting differs. Run 'npm run format'." >&2; exit 1; }
# --dry-run validates skill metadata and generated files without needing this machine to be installed.
python3 scripts/deploy.py --dry-run --backup-conflicts >/dev/null
