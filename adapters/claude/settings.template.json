{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{python_executable}} {{safety_gate}} --host claude",
            "timeout": 10,
            "statusMessage": "Checking for destructive commands"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{python_executable}} {{document_check}} --host claude",
            "timeout": 600,
            "statusMessage": "Checking Markdown formatting and Mermaid diagrams"
          }
        ]
      }
    ]
  }
}
