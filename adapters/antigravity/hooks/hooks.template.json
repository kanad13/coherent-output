{
  "destructive-command-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash {{safety_gate}}",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "prettier-auto-format": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash {{prettier_format}}",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
