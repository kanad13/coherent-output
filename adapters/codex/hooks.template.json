{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{python_executable}} {{document_check}} --host codex",
            "timeout": 600,
            "statusMessage": "Checking Markdown formatting and Mermaid diagrams"
          }
        ]
      }
    ]
  }
}
